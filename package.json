{
  "name": "besc-discordbot",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test tests/*.test.ts",
    "demo": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/demo.ts",
    "start": "node --env-file=.env dist/main.js",
    "commands:preview": "node src/register.ts",
    "commands:register": "node --env-file=.env src/register.ts --apply",
    "key:generate": "node src/keygen.ts"
  },
  "dependencies": {
    "discord.js": "14.27.0"
  },
  "devDependencies": {
    "@types/node": "22.19.0",
    "typescript": "5.9.3"
  }
}
