# Alleen serverconfiguratie. Geen echte geheimen in dit bestand.
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_GUILD_ID=
COMMANDCENTER_API_URL=https://cc-dev.belgianstreamerscommunity.be/api/v1/bot/
COMMANDCENTER_WEB_URL=https://cc-dev.belgianstreamerscommunity.be
BESC_BOT_API_KEY=
# Optional ticketing; leave empty for the existing read-only bot.
DISCORD_TICKET_PARENT_CHANNEL_ID=
# Explicit opt-in after CC scope configuration and review. False preserves V1.
BESC_TICKETING_V2=false
# Separate opt-in worker gate; CC's BESC_SLOT_DISCORD_NOTIFICATIONS_ENABLED remains a CC-only setting.
BESC_SLOT_WORKER_ENABLED=false
# Afzonderlijke opt-ins; laat beide uit tot aparte CC- en bot-DEV-acceptatie.
BESC_REWARDS_ENABLED=false
BESC_REWARDS_ACTIVITY_ENABLED=false
# Durable volume shared by separate ticket/panel and slot journals; never remove during updates.
BESC_BOT_STATE_DIR=/app/state

# Eigen campagnes via de bot: afzonderlijke scope en vrijgave vereist.
BESC_CAMPAIGN_COMMANDS_ENABLED=false

# Eigen kandidaatbijdragen; vereist campagnes en campaigns:own:write.
BESC_CAMPAIGN_SUBMISSIONS_ENABLED=false
